+            // 系统临时目录再执行副本，规避该目录限制；桩内烘焙的 UNINSTALLER_OUT_FILE
+            // 仍指向 outDir，产物不受影响。注意本文件 fs 是 require("fs")，非 fs-extra。
+            const os = require("os");
+            const stubRunDir = fs.mkdtempSync(path.join(os.tmpdir(), "electron-builder-stub-"));
+            const stubRunPath = path.join(stubRunDir, path.basename(installerPath));
+            fs.copyFileSync(installerPath, stubRunPath);
+            try {
+                await (0, wine_1.execWine)(stubRunPath, null, [], { env: { __COMPAT_LAYER: "RunAsInvoker" } });
+            }
+            finally {
+                fs.rmSync(stubRunDir, { recursive: true, force: true });
+            }
         }
         await packager.signIf(uninstallerPath);
         delete defines.BUILD_UNINSTALLER;
